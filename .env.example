# Copy to .env for development

NODE_ENV=development
PORT=3000

# Tenants are <slug>.<apex>
APEX_HOST=localhost

# One URL per role
DATABASE_URL=postgres://sm_app:sm-app-dev@127.0.0.1:55432/suara_madani
DATABASE_MIGRATOR_URL=postgres://sm_migrator:sm-migrator-dev@127.0.0.1:55432/suara_madani
DATABASE_MEDIA_URL=postgres://sm_media:sm-media-dev@127.0.0.1:55432/suara_madani
# Test database for bun test
TEST_DATABASE_URL=postgres://sm_app:sm-app-dev@127.0.0.1:55432/suara_madani_test
TEST_DATABASE_MIGRATOR_URL=postgres://sm_migrator:sm-migrator-dev@127.0.0.1:55432/suara_madani_test
# For SET ROLE in tests
TEST_DATABASE_SUPERUSER_URL=postgres://postgres:postgres-dev@127.0.0.1:55432/suara_madani_test

# Versioned: openssl rand -base64 32
BETTER_AUTH_SECRETS=
# Signed /lacak and unfollow links
# Newest first: 2:<base64>,1:<base64>
LACAK_LINK_KEYS=
# email_log and audit hashes
AUDIT_HMAC_KEY=

# Turnstile always-pass test keys
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# WhatsApp codes, dev: Mailpit
# Production: baileys or meta
WHATSAPP_PROVIDER=dev
# Base64 32 bytes, empty: email
WHATSAPP_JOB_KEY=
# Baileys session seal, base64
WHATSAPP_CREDS_KEY=

# Production: brevo
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Suara Madani <no-reply@localhost>
BREVO_API_KEY=
# Mailpit API, dev only
MAILPIT_URL=http://127.0.0.1:58025

# Empty token disables purge
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
ANON_CDN_TTL=60

# Operations
INTAKE_PAUSED=false
# bun run worker sets this
# e.g. WORKER_QUEUES=evidence
WORKER_QUEUES=
FILES_DIR=./.files

# Public video, R2 in production
# Dev: files/public serves it
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
# e.g. https://media.example.id
MEDIA_PUBLIC_ORIGIN=

# worker-media PDF scan, compose clamd
CLAMD_HOST=127.0.0.1
CLAMD_PORT=53310
