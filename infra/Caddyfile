# Behind cloudflared, plain HTTP inside
{
	admin off
	auto_https off
	persist_config off
	servers {
		# edge network, cloudflared only
		trusted_proxies static 172.31.10.0/24
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	# IP kept 30 days
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			# Daily roll: idle files age
			roll_interval 24h
			roll_keep 31
			roll_keep_for 720h
		}
		format filter {
			request>uri regexp "\?.*$" ""
			request>headers delete
			resp_headers delete
		}
	}

	# Joins the app req_id
	log_append cf_ray {http.request.header.Cf-Ray}

	# Caddy-made responses too
	header {
		?X-Content-Type-Options nosniff
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		?Strict-Transport-Security "{$HSTS_POLICY:max-age=300}"
	}

	@upload path /api/upload/*
	# Policy brief PDF, 10 MiB
	@brief {
		method POST
		path_regexp ^/kelola/tuntutan/[^/]+/unggah$
	}
	@other {
		not path /api/upload/*
		not {
			method POST
			path_regexp ^/kelola/tuntutan/[^/]+/unggah$
		}
	}
	request_body @upload {
		max_size 55MB
	}
	request_body @brief {
		max_size 11MB
	}
	request_body @other {
		max_size 1MB
	}

	# Hashed assets, kept 7 days
	handle /assets/* {
		root * /srv
		# Uplink and lab see compressed
		encode zstd gzip
		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			Strict-Transport-Security "{$HSTS_POLICY:max-age=300}"
		}
		file_server
	}

	# Public evidence, WebP only
	@media {
		path_regexp ^/media/[0-9a-f]{64}\.webp$
		header_regexp Host ^[a-z0-9][a-z0-9.-]*$
	}
	handle @media {
		root * /srv/public/{http.request.host}
		header {
			Content-Type image/webp
			X-Content-Type-Options nosniff
			Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors 'none'"
			Cache-Control "public, max-age=31536000, immutable"
			Strict-Transport-Security "{$HSTS_POLICY:max-age=300}"
		}
		file_server
	}
	handle /media/* {
		respond 404
	}

	# Umami tracker, same origin
	@stats-script {
		method GET HEAD
		path /stats/script.js
	}
	handle @stats-script {
		rewrite * /script.js
		reverse_proxy umami:3000 {
			header_up -Cookie
			header_down X-Content-Type-Options nosniff
			header_down Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			# REL-13: wedged Umami, bounded wait
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}
	@stats-send {
		method POST
		path /stats/api/send
	}
	handle @stats-send {
		rewrite * /api/send
		reverse_proxy umami:3000 {
			header_up -Cookie
			header_down X-Content-Type-Options nosniff
			header_down Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			header_up X-Client-IP {client_ip}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}
	# Umami UI stays private
	handle /stats/* {
		respond 404
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Client-IP {client_ip}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			# Hold requests while web restarts
			lb_try_duration 30s
			lb_try_interval 250ms
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
				keepalive 25s
			}
		}
	}

	handle_errors 502 503 504 {
		root * /etc/caddy
		rewrite * /503.html
		header {
			Retry-After 30
			Cache-Control no-store
			Content-Type "text/html; charset=utf-8"
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; style-src 'sha256-M4sOaJmCKrTuIZKhYisPhGxlSz4e5UO0Fgn42oPiw+U='; frame-ancestors 'none'"
			Strict-Transport-Security "{$HSTS_POLICY:max-age=300}"
		}
		file_server {
			status 503
		}
	}
}
