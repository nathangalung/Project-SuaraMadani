# Behind cloudflared, plain HTTP inside
{
	admin off
	auto_https off
	persist_config off
	servers {
		# edge network, cloudflared only
		trusted_proxies static 172.31.10.0/24
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	# IP kept 30 days
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep_for 720h
		}
		format filter {
			request>uri regexp "\?.*$" ""
			request>headers delete
			resp_headers delete
		}
	}

	@upload path /api/upload/*
	# Policy brief PDF, 10 MiB
	@brief {
		method POST
		path_regexp ^/kelola/tuntutan/[^/]+/unggah$
	}
	@other {
		not path /api/upload/*
		not {
			method POST
			path_regexp ^/kelola/tuntutan/[^/]+/unggah$
		}
	}
	request_body @upload {
		max_size 55MB
	}
	request_body @brief {
		max_size 11MB
	}
	request_body @other {
		max_size 1MB
	}

	# Hashed assets, kept 7 days
	handle /assets/* {
		root * /srv
		# Uplink and lab see compressed
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	# Public evidence, WebP only
	@media {
		path_regexp ^/media/[0-9a-f]{64}\.webp$
		header_regexp Host ^[a-z0-9][a-z0-9.-]*$
	}
	handle @media {
		root * /srv/public/{http.request.host}
		header {
			Content-Type image/webp
			X-Content-Type-Options nosniff
			Content-Security-Policy "sandbox; default-src 'none'"
			Cache-Control "public, max-age=31536000, immutable"
		}
		file_server
	}
	handle /media/* {
		respond 404
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Client-IP {client_ip}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			# Hold requests while web restarts
			lb_try_duration 30s
			lb_try_interval 250ms
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
				keepalive 25s
			}
		}
	}

	handle_errors 502 503 504 {
		root * /etc/caddy
		rewrite * /503.html
		header {
			Retry-After 30
			Cache-Control no-store
			Content-Type "text/html; charset=utf-8"
		}
		file_server {
			status 503
		}
	}
}
