# SSH-only tunnel, works before unlock
[Unit]
Description=Cloudflare Tunnel for Access SSH
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=/etc/cloudflared/ssh-tunnel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/ssh.yml tunnel run
Restart=on-failure
RestartSec=5s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
