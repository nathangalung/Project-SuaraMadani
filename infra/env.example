# Keys for infra/.env.sops, never plaintext
# Edit: sops infra/.env.sops
# Passwords: openssl rand -hex 32

# Images
APP_IMAGE=ghcr.io/<org>/sadar-bersuara
POSTGRES_IMAGE=ghcr.io/<org>/sadar-bersuara-postgres
# Digests: deploy.sh, .deployed-history
# Apex domain, tenants are subdomains
APEX_HOST=
TUNNEL_TOKEN=

# Database roles, hex only
POSTGRES_PASSWORD=
SB_MIGRATOR_PASSWORD=
SB_APP_PASSWORD=
SB_MEDIA_PASSWORD=
SB_BACKUP_PASSWORD=

# App secrets
BETTER_AUTH_SECRETS=
LACAK_LINK_KEYS=
AUDIT_HMAC_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# brevo or ses
EMAIL_PROVIDER=brevo
EMAIL_FROM=
BREVO_API_KEY=
# SES: region, IAM sender key
SES_REGION=ap-southeast-3
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Required, purge fails closed
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
ANON_CDN_TTL=60
INTAKE_PAUSED=false
# Bearer for /healthz/jobs checks
HEALTH_TOKEN=
# One year at launch, runbook
HSTS_POLICY=max-age=300

# WhatsApp codes: baileys or meta
WHATSAPP_PROVIDER=baileys
# false: incident lever, email only
WHATSAPP_ENABLED=true
# Base64 32 bytes, web too
WHATSAPP_JOB_KEY=
# Seals the linked session, Baileys
WHATSAPP_CREDS_KEY=
# Meta Cloud API, optional
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=
META_WA_LANGUAGE=id

# GlitchTip and Umami, Phase 2
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# openssl rand -hex 32
UMAMI_TWO_FACTOR_KEY=
# true after the runbook setup
ERROR_REPORTING=false
# Internal host: glitchtip:8000
GLITCHTIP_DSN=
# True once survey page ships
SURVEY_ENABLED=false
# Umami website, not secret
UMAMI_WEBSITE_ID=

# Public video bucket
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_ORIGIN=

# pgBackRest repo, R2
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# openssl rand -base64 48
PGBACKREST_REPO1_CIPHER_PASS=

# restic evidence repo, R2
RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/<bucket>
# openssl rand -base64 48
RESTIC_PASSWORD=
RESTIC_S3_KEY=
RESTIC_S3_KEY_SECRET=

# B2 copy age, listFiles key
B2_LIST_KEY_ID=
B2_LIST_KEY=
B2_BUCKET=
