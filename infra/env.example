# Keys for infra/.env.sops, never plaintext
# Edit: sops infra/.env.sops
# Passwords: openssl rand -hex 32

# Images
APP_IMAGE=ghcr.io/<org>/suara-madani
POSTGRES_IMAGE=ghcr.io/<org>/suara-madani-postgres
# POSTGRES_TAG: lib.sh postgres_tag
# Apex domain, tenants are subdomains
APEX_HOST=
TUNNEL_TOKEN=

# Database roles, hex only
POSTGRES_PASSWORD=
SM_MIGRATOR_PASSWORD=
SM_APP_PASSWORD=
SM_MEDIA_PASSWORD=
SM_BACKUP_PASSWORD=

# App secrets
BETTER_AUTH_SECRETS=
LACAK_LINK_KEYS=
AUDIT_HMAC_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
EMAIL_PROVIDER=brevo
EMAIL_FROM=
BREVO_API_KEY=
# Required, purge fails closed
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
ANON_CDN_TTL=60
INTAKE_PAUSED=false

# WhatsApp codes: baileys or meta
WHATSAPP_PROVIDER=baileys
# false: incident lever, email only
WHATSAPP_ENABLED=true
# Base64 32 bytes, web too
WHATSAPP_JOB_KEY=
# Seals the linked session, Baileys
WHATSAPP_CREDS_KEY=
# Meta Cloud API, optional
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=
META_WA_LANGUAGE=id

# Public video bucket
MEDIA_R2_ENDPOINT=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_ORIGIN=

# pgBackRest repo, R2
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=

# restic evidence repo, R2
RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/<bucket>
RESTIC_PASSWORD=
RESTIC_S3_KEY=
RESTIC_S3_KEY_SECRET=

# B2 copy age, listFiles key
B2_LIST_KEY_ID=
B2_LIST_KEY=
B2_BUCKET=
